# ---------------------------------------------------------------------------
# MediClaim / ClaimGen AI - environment configuration
# Copy this file to ".env" in the project root and fill in your values.
#   cp .env.example .env
# The backend also auto-loads "backend/.env" if you prefer to keep it local.
# ---------------------------------------------------------------------------

# --- AI provider ------------------------------------------------------------
#   huggingface  (default) - Hugging Face Inference Providers, needs HF_TOKEN
#   gemini                - Google Gemini, needs GEMINI_API_KEY
#   offline               - deterministic engine only, no token, no network
AI_PROVIDER=huggingface

# --- Hugging Face (default provider) ---------------------------------------
# 1. Create a token:  https://huggingface.co/settings/tokens
#    Type "Fine-grained" with "Read" permission is enough (free).
# 2. Paste it below and restart the backend.
# NEVER commit a real token - .env is gitignored. Leave blank to run the app
# in clearly-labelled offline mode (no AI calls).
HF_TOKEN=your_hf_token_here

# OpenAI-compatible endpoint. The Hugging Face router serves many models for
# free through this one URL, so you normally do not need to change it.
HF_BASE_URL=https://router.huggingface.co/v1

# Model names can be swapped without touching any code. All three are called
# by different agents; the default is served with a generous free tier.
#   document + extraction stage -> HF_MODEL_EXTRACTION
#   validation / generation     -> HF_MODEL_REASONING
#   final review                -> HF_MODEL_REVIEW
HF_MODEL_EXTRACTION=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_REASONING=Qwen/Qwen2.5-72B-Instruct
HF_MODEL_REVIEW=Qwen/Qwen2.5-72B-Instruct

# Alternatives worth trying if the default is busy or unavailable:
#   deepseek-ai/DeepSeek-V3-0324
#   meta-llama/Llama-3.3-70B-Instruct
#   mistralai/Mistral-Small-24B-Instruct-2501
#   google/gemma-3-27b-it
# Check that yours really answers before trusting it:
#   curl http://127.0.0.1:8080/api/health
# It reports "degraded" plus the reason if a token is invalid, a model is not
# served, or the endpoint is rate limited.

# Sampling / runtime knobs (shared by both providers)
AI_TEMPERATURE_EXTRACTION=0.0
AI_TEMPERATURE_REASONING=0.1
AI_REQUEST_TIMEOUT=180
AI_MAX_ATTEMPTS=3

# --- Google Gemini (optional alternative) -----------------------------------
# Only used when AI_PROVIDER=gemini. Get a key: https://aistudio.google.com/apikey
# NOTE: the 2.5 models are RETIRED for new keys (404 NOT_FOUND) - use the 3.x
# generation. Quota on free keys is small, which is why HF is the default.
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_MODEL_REVIEW=gemini-3.8-flash

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_CLAIM=10

# --- Forced offline mode ----------------------------------------------------
# Set to 1 to ignore any token and always use the deterministic engine.
# Handy for demos, cost control and verifying the no-AI path.
FORCE_OFFLINE=0

# --- Server -----------------------------------------------------------------
# Include your local dev origin and, once deployed, your Vercel URL:
#   http://localhost:5174,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173
LOG_LEVEL=INFO

# --- Application ------------------------------------------------------------
APP_NAME=ClaimGen AI
APP_VERSION=1.0.0
# Set to false to keep claims in memory only (nothing written to disk).
PERSIST_CLAIMS=true
