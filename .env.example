# ---------------------------------------------------------------------------
# MediClaim / ClaimGen AI - environment configuration
# Copy this file to ".env" in the project root and fill in your values.
#   cp .env.example .env
# The backend also auto-loads "backend/.env" if you prefer to keep it local.
# ---------------------------------------------------------------------------

# --- Gemini -----------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# NEVER commit a real key. Leave blank to run the app in clearly-labelled
# offline mode (no AI calls; see README "Running without an API key").
GEMINI_API_KEY=your_key_here

# Model names can be swapped without touching any code.
# NOTE: the 2.5 models (gemini-2.5-flash / gemini-2.5-pro) have been RETIRED
# for new API keys and now fail with 404 NOT_FOUND. Use the 3.x generation.
# Fast multimodal Flash model - used for document understanding + extraction.
GEMINI_MODEL_EXTRACTION=gemini-3.8-flash
# Stronger reasoning model, used where judgement (semantic consistency review)
# genuinely helps. Flash is fine for the default structured work and is much
# cheaper, so it is the default. To upgrade just this stage, try a pro model
# such as gemini-3.1-pro-preview (note: preview models can have tight quotas).
GEMINI_MODEL_REASONING=gemini-3.8-flash
# Review model - Flash is fast and sufficient for field-by-field checking.
GEMINI_MODEL_REVIEW=gemini-3.8-flash

# Check your key really can use the models above:
#   curl http://127.0.0.1:8000/api/health
# It reports "degraded" plus the reason if a model is retired, over quota or
# temporarily overloaded. Use the list in the response to pick a valid one.

# Sampling / runtime knobs
GEMINI_TEMPERATURE_EXTRACTION=0.0
GEMINI_TEMPERATURE_REASONING=0.1
GEMINI_REQUEST_TIMEOUT=180
GEMINI_MAX_ATTEMPTS=3

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_CLAIM=10

# --- Forced offline mode ----------------------------------------------------
# Set to 1 to ignore GEMINI_API_KEY and always use the deterministic engine.
# Handy for demos, cost control and verifying the no-AI path.
FORCE_OFFLINE=0

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Application ------------------------------------------------------------
APP_NAME=ClaimGen AI
APP_VERSION=1.0.0
# Set to false to keep claims in memory only (nothing written to disk).
PERSIST_CLAIMS=true
