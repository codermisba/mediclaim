# Vercel project configuration for the MediClaim / ClaimGen AI frontend.
#
# In the Vercel dashboard set the project Root Directory to "frontend" and add
# one environment variable:
#
#  VITE_API_BASE = 
#
# Leave it unset for local development: api.js then falls back to same-origin
# requests, which the Vite dev server proxies to the backend.

VITE_API_BASE=https://mediclaim-2aov.onrender.com
